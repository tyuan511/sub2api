# Local HTTPS entrypoint for monitor probes and browser testing.
# Caddy's internal CA makes sub2api.localhost trusted after `caddy trust`.
https://sub2api.localhost:8443 {
	tls internal

	# Backend API, gateway, health checks, and WebSocket endpoints.
	@backend path /api/* /v1/* /health /setup/* /ws/*
	reverse_proxy @backend 127.0.0.1:{$SERVER_PORT}

	# Vite development server for the browser UI. WebSocket upgrades are
	# handled automatically by reverse_proxy (used by Vite HMR).
	 reverse_proxy 127.0.0.1:{$FRONTEND_PORT}
}
